[project]
name = "{{ module_name }}"
version = "1.0.0"
description = "{{ extension_description }}"
authors = [{ name = "{{ user_name }}", email = "{{ user_email }}" }]
license = "MIT"
requires-python = ">=3.10"
dependencies = []

[dependency-groups]
dev = ["flockwave-server>=2.47.0"]

[project.entry-points."skybrush.server.ext"]
# Change the key below to the name of the extension that you want to use in
# configuration files, and the value to the name of the Python module that
# contains the extension code
{{ extension_name }} = "{{ module_name }}"

[project.scripts]
skybrushd = "flockwave.server.launcher:start"

[tool.ruff]
lint.ignore = [
  "B905", # zip-without-explicit-strict
  "S101", # assert
]
lint.select = [
  "B", # flake8-bugbear
  "C", # flake8-comprehensions
  "E", # pycodestyle errors
  "F", # pyflakes
  "I", # isort
  "S", # flake8-bandit
  "W", # pycodestyle warnings
]

[[tool.uv.index]]
name = "fury"
url = "https://pypi.fury.io/skybrush/"

[tool.uv.sources]
flockwave-server = { index = "fury" }

[build-system]
requires = ["uv_build>=0.11,<0.12"]
build-backend = "uv_build"
